.DS_Store
.env
.env.*
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
*.zip
*.tar
*.tar.gz
*.part
# Ignore raw files, but retain metadata records and indexes.
/data/raw/**
!/data/raw/**/
!/data/raw/**/.gitkeep
!/data/raw/**/indexes/**
!/data/raw/**/DOWNLOAD_RECORD.md
!/data/raw/**/SHA256SUMS.txt
# Derived full-resolution rasters and small sample TIFFs remain local.
/data/processed/*.tif
/data/processed/*.tiff
/data/processed/*.tmp*

# Latest publishing safeguard: no TIFFs or source-tile folders in commits.
*.tif
*.tiff
/data/raw/cedd/dsm/
/data/raw/cedd/dtm/
/data/raw/cedd/extracted/
